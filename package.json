{
  "name": "nestfactory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An IDE for NestJS: visual generators, module graph, database setup, API explorer, run/debug/test.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p ui/tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p ui/tsconfig.json --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "bridge": "cargo run -p nestfactory-bridge",
    "bindings": "cargo test -p nestfactory-core -p nestfactory-service export_bindings",
    "test": "cargo test --workspace"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
